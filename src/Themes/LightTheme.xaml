<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Verzio: v0.5.0 - 2026-09-13
         Lasd DarkTheme.xaml - ugyanaz a kulcs-keszlet, vilagos ertekekkel,
         hogy a tema-valtas tenylegesen lathato legyen a teljes feluleten. -->

    <!-- Nyers színek (Color) - Ezeket csak belső hivatkozásra használjuk -->
    <Color x:Key="BgColor">#F5F5F5</Color>
    <Color x:Key="AccentColor">#008F24</Color> 
    <Color x:Key="SecondaryColor">#0097A7</Color>

    <!-- Panelek -->
    <Color x:Key="PanelBgColor">#FFFFFF</Color>
    <Color x:Key="PanelBorderColor">#DADADA</Color>
    <Color x:Key="HeaderBgColor">#FFFFFF</Color>
    <Color x:Key="SubPanelBgColor">#EDEDED</Color>

    <!-- Gombok -->
    <Color x:Key="ButtonBgColor">#FFFFFF</Color>
    <Color x:Key="ButtonHoverBgColor">#E8F5E9</Color>
    <Color x:Key="ButtonHoverBorderColor">#00B32C</Color>
    <Color x:Key="ButtonPressedBgColor">#B3E5FC</Color>
    <Color x:Key="ButtonPressedBorderColor">#0097A7</Color>

    <!-- Gorgetosav -->
    <Color x:Key="ScrollTrackColor">#EAEAEA</Color>
    <Color x:Key="ScrollThumbColor">#008F24</Color>
    <Color x:Key="ScrollThumbHoverColor">#00B32C</Color>

    <!-- Ecsetek (Brush) - Ezeket látja a felület (Foreground/Background) -->
    <SolidColorBrush x:Key="AccentNeon" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="SecondaryNeon" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="MainBgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="#212121"/>

    <SolidColorBrush x:Key="PanelBgBrush" Color="{StaticResource PanelBgColor}"/>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="{StaticResource PanelBorderColor}"/>
    <SolidColorBrush x:Key="HeaderBgBrush" Color="{StaticResource HeaderBgColor}"/>
    <SolidColorBrush x:Key="SubPanelBgBrush" Color="{StaticResource SubPanelBgColor}"/>

    <SolidColorBrush x:Key="ButtonBgBrush" Color="{StaticResource ButtonBgColor}"/>
    <SolidColorBrush x:Key="ButtonHoverBgBrush" Color="{StaticResource ButtonHoverBgColor}"/>
    <SolidColorBrush x:Key="ButtonHoverBorderBrush" Color="{StaticResource ButtonHoverBorderColor}"/>
    <SolidColorBrush x:Key="ButtonPressedBgBrush" Color="{StaticResource ButtonPressedBgColor}"/>
    <SolidColorBrush x:Key="ButtonPressedBorderBrush" Color="{StaticResource ButtonPressedBorderColor}"/>

    <SolidColorBrush x:Key="ScrollTrackBrush" Color="{StaticResource ScrollTrackColor}"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="{StaticResource ScrollThumbHoverColor}"/>

</ResourceDictionary>
