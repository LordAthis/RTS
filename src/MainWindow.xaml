<Window x:Class="RTS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="RTS" Height="650" Width="1100"
        Icon="Assets/app.ico"
        MinHeight="560" MinWidth="960"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <!-- Verzio: v0.5.0 - 2026-09-13
         A NeonButtonStyle innen KIKERULT: a ket parhuzamos (App.xaml es
         itteni) valtozat kozul ez a "kozelebbi" (Window.Resources) nyert
         mindig a WPF felbontasi sorrend miatt, EZERT nem szamitott, hogy
         az App.xaml-beli valtozat theme-fuggo lett volna vagy sem. Most
         EGYETLEN, kozponti, temafuggo valtozat el az App.xaml-ban. -->

    <Grid>
        <!-- FŐ KERET -->
        <Border x:Name="MainBorder" CornerRadius="20"
                Background="{DynamicResource MainBgBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="2"
                Panel.ZIndex="0"
                Margin="20,45,20,20">

            <Grid Margin="15,40,15,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- BAL OLDAL (fő tartalom) - Grid, NEM StackPanel: az A2-nek
                     a TENYLEGESEN rendelkezesre allo helyet kell kapnia (*),
                     nem egy fix pixelszamot, kulonben kis ablakmeretnel az
                     also resze levagodik (es az A2-n beluli ScrollViewer
                     sem tud helyesen mukodni, mert hamis magassagot lat). -->
                <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,15,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border x:Name="A1_LoadingBorder" Grid.Row="0" MinHeight="70" Background="{DynamicResource PanelBgBrush}" CornerRadius="12" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="2">
                        <TextBlock x:Name="TxtInfo" Text="Rendszer készenlétben..." Foreground="Gray" Margin="15" VerticalAlignment="Center" FontSize="14" FontStyle="Italic" TextWrapping="Wrap"/>
                    </Border>
                    <Border x:Name="A2_Area" Grid.Row="1" Margin="0,15,0,0" Background="{DynamicResource MainBgBrush}" CornerRadius="12" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                        <ContentControl x:Name="MainContentArea"/>
                    </Border>
                </Grid>

                <!-- JOBB OLDAL (panelek + log) -->
                <Grid Grid.Row="1" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1.5*"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" x:Name="B1_Area" Margin="0,0,0,8" Background="{DynamicResource PanelBgBrush}" CornerRadius="12" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                        <TextBlock Text="B1: GYORSELÉRÉS" Foreground="#666" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
                    </Border>
                    <Border Grid.Row="1" x:Name="B2_Area" Margin="0,8" Background="{DynamicResource PanelBgBrush}" CornerRadius="12" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                        <ContentControl x:Name="B2Content">
                            <TextBlock Text="B2: ESZKÖZÖK" Foreground="#666" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
                        </ContentControl>
                    </Border>
                    <!-- Verzio v0.5.4 - 2026-09-14 - JAVITAS: az elozo korben tevesen a
                         GOMBOKAT toltuk fel (RenderTransform), ami felesleges ures
                         teruletet hagyott. A HELYES megoldas (ahogy az A2-nel is
                         mukodik): a doboz KERETE nyulik le a gombsor moge
                         (Grid.RowSpan="2", a 2. ES 3. sort is lefedi), a gombok
                         a sajat, valtozatlan helyukon maradnak. Ez egyben nagyobb
                         is lesz a B3 (tobb hely a log-szovegnek), ahogy kertek. -->
                    <Border Grid.Row="2" Grid.RowSpan="2" Margin="0,8,0,0" Background="{DynamicResource PanelBgBrush}" CornerRadius="12" BorderBrush="{DynamicResource AccentNeon}" BorderThickness="1">
                        <ScrollViewer x:Name="LogScroller">
                            <TextBlock x:Name="TxtLog" Text="[RTS Core Initialized...]" Foreground="{DynamicResource AccentNeon}" FontFamily="Consolas" FontSize="11" Margin="10" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>

                    <!-- jobb alsó kis gombok: Eszközök + LOG mentés + GitHub/Blog/LinkedIn/Mail ikonok.
                         A gombsor a SAJAT, eredeti helyen marad (nincs RenderTransform) -
                         a B3 keret nyulik alája/moge (lasd fent), igy nez ki ugyanugy,
                         mint az A2 also lebego gombjainal. -->
                    <Grid Grid.Row="3" VerticalAlignment="Bottom">
                        <!-- Verzio v0.5.6 - 2026-09-14 - JAVITAS: a jobb oldali
                             gombsor alsó vonala nem esett egybe a bal-also
                             lebego gombok (theme/info/donate/exit) alsó
                             vonalaval - kiszamolva: a jobb oldali 37px-re volt
                             az ablak aljatol, a bal oldali 28px-re (a
                             MainBorder+belso Grid margo-lanca miatt). A
                             -9px-es also margo pontosan kiegyenliti ezt,
                             FUGGETLENUL attol, hogy a gombok mereteben van-e
                             kulonbseg (a Bottom-igazitas es ez a korrekcio
                             barmilyen gombmerettel egy vonalban tartja oket). -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,-9">
                            <!-- Verzio v0.5.0 - 2026-09-13: uj gomb - "Eszkozok" (hardver-
                                 lekerdezo panel) megnyitasa. A LOG gombtol balra, ahogy kertek. -->
                            <Button x:Name="BtnTools" Style="{StaticResource NeonButtonStyle}" Width="35" Height="35" Margin="2"
                                    ToolTip="Eszkozok (hardver-lekerdezes)" Click="Module_Click">
                                <TextBlock Text="🔧" FontSize="15"/>
                            </Button>
                            <Button x:Name="BtnSaveLog" Style="{StaticResource NeonButtonStyle}" MinWidth="60" Height="35" Margin="2"
                                    ToolTip="Log mentese fajlba (C:\Program Files\RTS\LOG)" Click="BtnSaveLog_Click">
                                <TextBlock Text="💾 LOG" FontSize="12"/>
                            </Button>
                            <Button x:Name="BtnGH" Style="{StaticResource NeonButtonStyle}" Width="35" Height="35" Margin="2"
                                    ToolTip="GitHub repo megnyitasa" Click="BtnGH_Click">
                                <Border Width="20" Height="20" CornerRadius="10" Background="#00FF41">
                                    <TextBlock Text="GH" FontSize="8" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Button>
                            <Button x:Name="BtnWeb" Style="{StaticResource NeonButtonStyle}" Width="35" Height="35" Margin="2"
                                    ToolTip="Blog megnyitasa (lordathis.blogspot.com)" Click="BtnWeb_Click">
                                <Border Width="20" Height="20" CornerRadius="10" Background="#FF7A1A">
                                    <TextBlock Text="B" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Button>
                            <Button x:Name="BtnLn" Style="{StaticResource NeonButtonStyle}" Width="35" Height="35" Margin="2"
                                    ToolTip="LinkedIn profil megnyitasa" Click="BtnLn_Click">
                                <Border Width="20" Height="20" CornerRadius="4" Background="#0A66C2">
                                    <TextBlock Text="in" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Button>
                            <!-- Verzio v0.5.0: 40x40 -> 35x35, hogy egyezzen a sor tobbi
                                 gombjaval (korabban egyedul ez volt nagyobb). -->
                            <Button x:Name="BtnMail" Style="{StaticResource NeonButtonStyle}" Width="35" Height="35" Margin="2"
                                    ToolTip="A LOG kuldese DiagMailer-el" Click="BtnMail_Click">
                                <Image Source="Assets/mail_diagmailer.png" Width="27" Height="27" Stretch="Uniform" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- FEJLÉC (kilóg felül) – Grid alapú, dinamikusan alkalmazkodik az ablak
             szélességéhez (a * oszlopok nyelik el a felesleges helyet), nincs
             tobbe fix "holt ter" a szelso elemek korul. -->
        <Grid VerticalAlignment="Top" HorizontalAlignment="Stretch" Height="68"
              Margin="30,-12,30,0" Panel.ZIndex="2" IsHitTestVisible="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Bal csoport: Home + OS-valaszto -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
                <Button x:Name="BtnHome" Content="🏠" Style="{StaticResource NeonButtonStyle}" Width="45" Height="45"
                        ToolTip="Fooldal" Click="Module_Click"/>

                <Border Background="{DynamicResource SubPanelBgBrush}" CornerRadius="12" Padding="5" Margin="10,0,0,0" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnXP"   Content="XP"  Style="{StaticResource NeonButtonStyle}" MinWidth="35" Margin="2" ToolTip="Cel-OS: Windows XP" Click="Module_Click"/>
                        <Button x:Name="BtnWin7" Content="7"   Style="{StaticResource NeonButtonStyle}" MinWidth="35" Margin="2" ToolTip="Cel-OS: Windows 7" Click="Module_Click"/>
                        <Button x:Name="BtnWin10" Content="10" Style="{StaticResource NeonButtonStyle}" MinWidth="35" Margin="2" ToolTip="Cel-OS: Windows 10" Click="Module_Click"/>
                        <Button x:Name="BtnWin11" Content="11" Style="{StaticResource NeonButtonStyle}" MinWidth="35" Margin="2" ToolTip="Cel-OS: Windows 11" Click="Module_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Cim, kozepen (a *-*oszlopok kozott, mindig kozepen marad) -->
            <Border Grid.Column="2" Background="{DynamicResource HeaderBgBrush}" CornerRadius="15" Padding="20,5" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="NEXUS" Foreground="{DynamicResource AccentNeon}" VerticalAlignment="Center" FontWeight="Bold" FontSize="35"/>
                    <TextBlock Text="Bit&amp;Chip s.r.o." Foreground="{DynamicResource AccentNeon}" VerticalAlignment="Center" FontWeight="Bold" FontSize="20" Margin="4,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- Jobb csoport: modul gyorsgombok (Kedvencek, WRT, STP, IWS, NET, MOD).
                 Verzio v0.5.0: az "F1" (Info) gomb innen ATKERULT a bal also
                 sarokba (a tema-valto es kilepes gomb koze) - lasd lent. A
                 helyere egy uj, villam-ikonos "Kedvenc feladatok" gomb kerult. -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,10,0">
                <Button x:Name="BtnFavorites" Content="⚡" Style="{StaticResource NeonButtonStyle}" MinWidth="50" Margin="3,0"
                        ToolTip="Kedvenc feladatok - automatikus sorozat futtatasa (leiras kesobb)" Click="Module_Click"/>
                <Button x:Name="BtnWRT" Content="WRT" Style="{StaticResource NeonButtonStyle}" MinWidth="50" Margin="3,0"
                        ToolTip="WinRegTools" Click="Module_Click"/>
                <Button x:Name="BtnSTP" Content="STP" Style="{StaticResource NeonButtonStyle}" MinWidth="50" Margin="3,0"
                        ToolTip="SetUpER" Click="Module_Click"/>
                <Button x:Name="BtnIWS" Content="📦 IWS" Style="{StaticResource NeonButtonStyle}" MinWidth="70" Margin="3,0"
                        ToolTip="IWS - Biztonsagi hardening modul" Click="Module_Click"/>
                <Button x:Name="BtnNet" Content="🌐 NET" Style="{StaticResource NeonButtonStyle}" MinWidth="70" Margin="3,0"
                        ToolTip="Halozati eszkozok" Click="Module_Click"/>
                <Button x:Name="BtnModules" Content="🗂 MOD" Style="{StaticResource NeonButtonStyle}" MinWidth="70" Margin="3,0"
                        ToolTip="Osszes modul listaja es futtatasa" Click="Module_Click"/>
            </StackPanel>
        </Grid>

        <!-- BAL ALSÓ SAROK – lebegő gombok (theme + info + exit).
             Verzio v0.5.0: az "Info" (korabban "F1" a fejlecben) gomb ide
             koltozott, a tema-valto es a kilepes gomb koze, "i" felirattal. -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="45,0,0,28" Panel.ZIndex="3">
            <Button x:Name="BtnThemeToggle" Content="🌓" Style="{StaticResource NeonButtonStyle}" Width="42" Height="42" Margin="0,0,10,0"
                    ToolTip="Sotet/vilagos tema valtas" Click="BtnThemeToggle_Click"/>
            <Button x:Name="BtnInfo" Content="i" FontWeight="Bold" FontSize="18" Style="{StaticResource NeonButtonStyle}" Width="42" Height="42" Margin="0,0,10,0"
                    ToolTip="Rendszerinfo es gyorsinditó" Click="Module_Click"/>
            <!-- Verzio v0.5.5 - 2026-09-14: uj gomb - csak a donate.json-t
                 tolti be (lasd DonateView) - a Home ezt a fajlt is beemeli,
                 de EGYUTT az RTS-info.json-nal, ez a gomb pedig ONALLOAN. -->
            <Button x:Name="BtnDonate" Content="💰" FontSize="18" Style="{StaticResource NeonButtonStyle}" Width="42" Height="42" Margin="0,0,10,0"
                    ToolTip="Tamogatas (Donate)" Click="Module_Click"/>
            <Button x:Name="BtnExit" Content="✕" Style="{StaticResource NeonButtonStyle}" Width="42" Height="42"
                    ToolTip="Kilepes az RTS-bol" Click="BtnExit_Click"/>
        </StackPanel>

        <!-- ABLAK-ATMERETEZO SZEGELYEK (lathatatlanok, a transzparens keret-resben)
             WindowStyle="None" + AllowsTransparency miatt kulon kell kezelni. -->
        <Border Panel.ZIndex="10" Background="Transparent" Width="8" HorizontalAlignment="Left" Margin="0,45,0,20"
                Cursor="SizeWE" Tag="Left" MouseLeftButtonDown="ResizeWindow"/>
        <Border Panel.ZIndex="10" Background="Transparent" Width="8" HorizontalAlignment="Right" Margin="0,45,0,20"
                Cursor="SizeWE" Tag="Right" MouseLeftButtonDown="ResizeWindow"/>
        <Border Panel.ZIndex="10" Background="Transparent" Height="8" VerticalAlignment="Top" Margin="20,0,20,0"
                Cursor="SizeNS" Tag="Top" MouseLeftButtonDown="ResizeWindow"/>
        <Border Panel.ZIndex="10" Background="Transparent" Height="8" VerticalAlignment="Bottom" Margin="20,0,20,0"
                Cursor="SizeNS" Tag="Bottom" MouseLeftButtonDown="ResizeWindow"/>
        <Border Panel.ZIndex="10" Background="Transparent" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top"
                Cursor="SizeNWSE" Tag="TopLeft" MouseLeftButtonDown="ResizeWindow"/>
        <Border Panel.ZIndex="10" Background="Transparent" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top"
                Cursor="SizeNESW" Tag="TopRight" MouseLeftButtonDown="ResizeWindow"/>
        <Border Panel.ZIndex="10" Background="Transparent" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Cursor="SizeNESW" Tag="BottomLeft" MouseLeftButtonDown="ResizeWindow"/>
        <Border Panel.ZIndex="10" Background="Transparent" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Cursor="SizeNWSE" Tag="BottomRight" MouseLeftButtonDown="ResizeWindow"/>
    </Grid>
</Window>
