<Window x:Class="RTS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="RTS" Height="650" Width="1100"
        Icon="Assets/app.ico"
        MinHeight="560" MinWidth="960"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- NEON GOMB STÍLUS – háttér + hover + click villanás -->
        <Style x:Key="NeonButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="#00FF41"/>
            <Setter Property="BorderBrush" Value="#00FF41"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1F1F1F"/>
                                <Setter Property="BorderBrush" Value="#00FF9F"/>
                                <Setter Property="Foreground" Value="#00FF9F"/>
                            </Trigger>
                            <!-- Pressed (villanás) -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#00BFFF"/>
                                <Setter Property="BorderBrush" Value="#00FFFF"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- FŐ KERET -->
        <Border x:Name="MainBorder" CornerRadius="20"
                Background="{DynamicResource MainBgBrush}"
                BorderBrush="#222" BorderThickness="2"
                Panel.ZIndex="0"
                Margin="20,45,20,20">

            <Grid Margin="15,40,15,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- BAL OLDAL (fő tartalom) -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,15,0">
                    <Border x:Name="A1_LoadingBorder" MinHeight="70" Background="#111" CornerRadius="12" BorderBrush="#222" BorderThickness="2">
                        <TextBlock x:Name="TxtInfo" Text="Rendszer készenlétben..." Foreground="Gray" Margin="15" VerticalAlignment="Center" FontSize="14" FontStyle="Italic" TextWrapping="Wrap"/>
                    </Border>
                    <Border x:Name="A2_Area" Height="460" Margin="0,15,0,0" Background="#0A0A0A" CornerRadius="12" BorderBrush="#222" BorderThickness="1">
                        <ContentControl x:Name="MainContentArea"/>
                    </Border>
                </StackPanel>

                <!-- JOBB OLDAL (panelek + log) -->
                <Grid Grid.Row="1" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1.5*"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" x:Name="B1_Area" Margin="0,0,0,8" Background="#111" CornerRadius="12" BorderBrush="#222" BorderThickness="1">
                        <TextBlock Text="B1: GYORSELÉRÉS" Foreground="#333" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
                    </Border>
                    <Border Grid.Row="1" x:Name="B2_Area" Margin="0,8" Background="#111" CornerRadius="12" BorderBrush="#222" BorderThickness="1">
                        <TextBlock Text="B2: ESZKÖZÖK" Foreground="#333" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
                    </Border>
                    <Border Grid.Row="2" Margin="0,8" Background="Black" CornerRadius="12" BorderBrush="{DynamicResource AccentNeon}" BorderThickness="1">
                        <ScrollViewer x:Name="LogScroller">
                            <TextBlock x:Name="TxtLog" Text="[RTS Core Initialized...]" Foreground="{DynamicResource AccentNeon}" FontFamily="Consolas" FontSize="11" Margin="10" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>

                    <!-- jobb alsó kis gombok: LOG mentés + GitHub/Blog/LinkedIn ikonok -->
                    <Grid Grid.Row="3" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnSaveLog" Style="{StaticResource NeonButtonStyle}" MinWidth="60" Height="35" Margin="2"
                                    ToolTip="Log mentese fajlba (C:\Program Files\RTS\LOG)" Click="BtnSaveLog_Click">
                                <TextBlock Text="💾 LOG" FontSize="12"/>
                            </Button>
                            <Button x:Name="BtnGH" Style="{StaticResource NeonButtonStyle}" Width="35" Height="35" Margin="2"
                                    ToolTip="GitHub repo megnyitasa" Click="BtnGH_Click">
                                <Border Width="20" Height="20" CornerRadius="10" Background="#00FF41">
                                    <TextBlock Text="GH" FontSize="8" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Button>
                            <Button x:Name="BtnWeb" Style="{StaticResource NeonButtonStyle}" Width="35" Height="35" Margin="2"
                                    ToolTip="Blog megnyitasa (lordathis.blogspot.com)" Click="BtnWeb_Click">
                                <Border Width="20" Height="20" CornerRadius="10" Background="#FF7A1A">
                                    <TextBlock Text="B" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Button>
                            <Button x:Name="BtnLn" Style="{StaticResource NeonButtonStyle}" Width="35" Height="35" Margin="2"
                                    ToolTip="LinkedIn profil megnyitasa" Click="BtnLn_Click">
                                <Border Width="20" Height="20" CornerRadius="4" Background="#0A66C2">
                                    <TextBlock Text="in" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Button>
                            <Button x:Name="BtnMail" Style="{StaticResource NeonButtonStyle}" Width="40" Height="40" Margin="2"
                                    ToolTip="A LOG kuldese DiagMailer-el" Click="BtnMail_Click">
                                <Image Source="Assets/mail_diagmailer.png" Width="32" Height="32" Stretch="Uniform" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- FEJLÉC (kilóg felül) – Grid alapú, dinamikusan alkalmazkodik az ablak
             szélességéhez (a * oszlopok nyelik el a felesleges helyet), nincs
             tobbe fix "holt ter" a szelso elemek korul. -->
        <Grid VerticalAlignment="Top" HorizontalAlignment="Stretch" Height="68"
              Margin="30,-12,30,0" Panel.ZIndex="2" IsHitTestVisible="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Bal csoport: Home + OS-valaszto -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
                <Button x:Name="BtnHome" Content="🏠" Style="{StaticResource NeonButtonStyle}" Width="45" Height="45"
                        ToolTip="Fooldal" Click="Module_Click"/>

                <Border Background="#1A1A1A" CornerRadius="12" Padding="5" Margin="10,0,0,0" BorderBrush="#333" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnXP"   Content="XP"  Style="{StaticResource NeonButtonStyle}" MinWidth="35" Margin="2" ToolTip="Cel-OS: Windows XP" Click="Module_Click"/>
                        <Button x:Name="BtnWin7" Content="7"   Style="{StaticResource NeonButtonStyle}" MinWidth="35" Margin="2" ToolTip="Cel-OS: Windows 7" Click="Module_Click"/>
                        <Button x:Name="BtnWin10" Content="10" Style="{StaticResource NeonButtonStyle}" MinWidth="35" Margin="2" ToolTip="Cel-OS: Windows 10" Click="Module_Click"/>
                        <Button x:Name="BtnWin11" Content="11" Style="{StaticResource NeonButtonStyle}" MinWidth="35" Margin="2" ToolTip="Cel-OS: Windows 11" Click="Module_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Cim, kozepen (a *-*oszlopok kozott, mindig kozepen marad) -->
            <Border Grid.Column="2" Background="Black" CornerRadius="15" Padding="20,5" BorderBrush="#444" BorderThickness="1" VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="NEXUS" Foreground="{DynamicResource AccentNeon}" VerticalAlignment="Center" FontWeight="Bold" FontSize="35"/>
                    <TextBlock Text="Bit&amp;Chip s.r.o." Foreground="{DynamicResource AccentNeon}" VerticalAlignment="Center" FontWeight="Bold" FontSize="20" Margin="4,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- Jobb csoport: modul gyorsgombok (F1, WRT, STP, IWS, NET, MOD) -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,10,0">
                <Button x:Name="BtnRTS" Content="F1" Style="{StaticResource NeonButtonStyle}" MinWidth="50" Margin="3,0"
                        ToolTip="Rendszerinfo es gyorsinditó" Click="Module_Click"/>
                <Button x:Name="BtnWRT" Content="WRT" Style="{StaticResource NeonButtonStyle}" MinWidth="50" Margin="3,0"
                        ToolTip="WinRegTools" Click="Module_Click"/>
                <Button x:Name="BtnSTP" Content="STP" Style="{StaticResource NeonButtonStyle}" MinWidth="50" Margin="3,0"
                        ToolTip="SetUpER" Click="Module_Click"/>
                <Button x:Name="BtnIWS" Content="📦 IWS" Style="{StaticResource NeonButtonStyle}" MinWidth="70" Margin="3,0"
                        ToolTip="IWS - Biztonsagi hardening modul" Click="Module_Click"/>
                <Button x:Name="BtnNet" Content="🌐 NET" Style="{StaticResource NeonButtonStyle}" MinWidth="70" Margin="3,0"
                        ToolTip="Halozati eszkozok" Click="Module_Click"/>
                <Button x:Name="BtnModules" Content="🗂 MOD" Style="{StaticResource NeonButtonStyle}" MinWidth="70" Margin="3,0"
                        ToolTip="Osszes modul listaja es futtatasa" Click="Module_Click"/>
            </StackPanel>
        </Grid>

        <!-- BAL ALSÓ SAROK – lebegő gombok (theme + exit) -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="45,0,0,28" Panel.ZIndex="3">
            <Button x:Name="BtnThemeToggle" Content="🌓" Style="{StaticResource NeonButtonStyle}" Width="42" Height="42" Margin="0,0,10,0"
                    ToolTip="Sotet/vilagos tema valtas" Click="BtnThemeToggle_Click"/>
            <Button x:Name="BtnExit" Content="✕" Style="{StaticResource NeonButtonStyle}" Width="42" Height="42"
                    ToolTip="Kilepes az RTS-bol" Click="BtnExit_Click"/>
        </StackPanel>

        <!-- ABLAK-ATMERETEZO SZEGELYEK (lathatatlanok, a transzparens keret-resben)
             WindowStyle="None" + AllowsTransparency miatt kulon kell kezelni. -->
        <Border Panel.ZIndex="10" Background="Transparent" Width="8" HorizontalAlignment="Left" Margin="0,45,0,20"
                Cursor="SizeWE" Tag="Left" MouseLeftButtonDown="ResizeWindow"/>
        <Border Panel.ZIndex="10" Background="Transparent" Width="8" HorizontalAlignment="Right" Margin="0,45,0,20"
                Cursor="SizeWE" Tag="Right" MouseLeftButtonDown="ResizeWindow"/>
        <Border Panel.ZIndex="10" Background="Transparent" Height="8" VerticalAlignment="Top" Margin="20,0,20,0"
                Cursor="SizeNS" Tag="Top" MouseLeftButtonDown="ResizeWindow"/>
        <Border Panel.ZIndex="10" Background="Transparent" Height="8" VerticalAlignment="Bottom" Margin="20,0,20,0"
                Cursor="SizeNS" Tag="Bottom" MouseLeftButtonDown="ResizeWindow"/>
        <Border Panel.ZIndex="10" Background="Transparent" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top"
                Cursor="SizeNWSE" Tag="TopLeft" MouseLeftButtonDown="ResizeWindow"/>
        <Border Panel.ZIndex="10" Background="Transparent" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top"
                Cursor="SizeNESW" Tag="TopRight" MouseLeftButtonDown="ResizeWindow"/>
        <Border Panel.ZIndex="10" Background="Transparent" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Cursor="SizeNESW" Tag="BottomLeft" MouseLeftButtonDown="ResizeWindow"/>
        <Border Panel.ZIndex="10" Background="Transparent" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Cursor="SizeNWSE" Tag="BottomRight" MouseLeftButtonDown="ResizeWindow"/>
    </Grid>
</Window>
