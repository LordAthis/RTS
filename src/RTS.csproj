<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms> <!-- FolderBrowserDialog-hoz (elso-inditasi telepito) -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RootNamespace>RTS</RootNamespace>
    <AssemblyName>RTS</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Verzio v0.5.8 - 2026-09-14: az RTS-info.json es a donate.json
         TARTALMA mostantol BE VAN EGETVE az exe-be build-idoben, garantalt
         tartalek/fallback kent. Miert: korabban ha a gyokerben levo KULSO
         fajl hianyzott vagy hibas volt (pl. kezi szerkesztesi hiba a
         GitHub-on), a felhasznalo egyszeruen nem latott SEMMI informaciot -
         holott a repo-ban magaban a helyes tartalom megvolt, csak nem
         jutott el a mar telepitett exe-hez frissites nelkul. Ezzent minden
         UJ build automatikusan magaval viszi a build-idobeli tartalmat, es
         (lasd HomeInfoView/DonateView) a kulso fajl csak akkor szamit, ha
         LETEZIK ES ervenyes - egyebkent nesztelenul erre a beegetett
         valtozatra esik vissza, SOSEM marad ures/hibas a felulet.
         A kulso fajl igy tovabbra is hasznalhato gyors, ujraforditas nelkuli
         szerkesztesre - csak mar nem az EGYETLEN forras. -->
    <EmbeddedResource Include="..\RTS-info.json" LogicalName="RTS.EmbeddedResources.RTS-info.json" />
    <EmbeddedResource Include="..\donate.json" LogicalName="RTS.EmbeddedResources.donate.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Verzio v0.5.4 - 2026-09-14: kripto-tarca QR-kodokhoz (lasd
         Services/QrCodeHelper.cs). Tiszta C#, nincs kulso fuggosege
         (System.Drawing-ot sem igenyel), MIT licenc. A NuGet-restore-t a
         GitHub Actions windows-latest runner vegzi buildkor. -->
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Az .ico-t WPF-eroforraskent is bevonjuk, hogy a Window.Icon (pack URI)
         is fel tudja oldani - az ApplicationIcon fentebb csak az .exe fajl
         sajat ikonjat allitja be (Intezo/taskbar), ez pedig a WPF ablak
         sajat ikonjat (Alt+Tab, ablak bal felso sarka). -->
    <Resource Include="Assets\app.ico" />
    <!-- v0.4.2: a LOG->DiagMailer gomb ikonja (felhasznalo altal jovahagyott,
         Gemini-vel generalt "repulo boritek + LOG felirat" grafika). -->
    <Resource Include="Assets\mail_diagmailer.png" />
  </ItemGroup>
  <ItemGroup>
    <!-- Verzio v2.0.0 - 2026-09-16 (round17): a hardver-lekerdezo
         PowerShell-scriptek BE VANNAK EGETVE az exe-be, ugyanazon elv
         alapjan, mint fentebb az RTS-info.json / donate.json.

         MIERT: ha a scriptek csak kulso fajlkent lennenek jelen, egy
         hianyzo, felulirt vagy elavult fajl eseten a lekerdezes csendben
         elhasalna - pontosan azt a hibafajtat hoznank vissza, amit a
         round17 meg akar szuntetni. Igy MINDEN build magaval viszi a
         sajat, hozza tartozo script-verziot.

         A HwScriptRunner indulaskor kiirja oket a
         <InstallRoot>\data\Scripts\Hw\ mappaba, ahol a felhasznalo
         meg tudja nyitni es el tudja olvasni oket (LordAthis kifejezett
         kerese volt, hogy a lekerdezesek kulon, LATHATO .ps1 fajlok
         legyenek) - a tartalmuk viszont mindig az exe-vel egyezik. -->
    <EmbeddedResource Include="Scripts\Hw\Get-HardwareReport.ps1" LogicalName="RTS.EmbeddedResources.Hw.Get-HardwareReport.ps1" />
    <EmbeddedResource Include="Scripts\Hw\Get-SystemInfo.ps1"    LogicalName="RTS.EmbeddedResources.Hw.Get-SystemInfo.ps1" />
    <EmbeddedResource Include="Scripts\Hw\Get-CpuInfo.ps1"       LogicalName="RTS.EmbeddedResources.Hw.Get-CpuInfo.ps1" />
    <EmbeddedResource Include="Scripts\Hw\Get-GpuInfo.ps1"       LogicalName="RTS.EmbeddedResources.Hw.Get-GpuInfo.ps1" />
    <EmbeddedResource Include="Scripts\Hw\Get-DiskInfo.ps1"      LogicalName="RTS.EmbeddedResources.Hw.Get-DiskInfo.ps1" />
    <EmbeddedResource Include="Scripts\Hw\Get-SensorInfo.ps1"    LogicalName="RTS.EmbeddedResources.Hw.Get-SensorInfo.ps1" />
    <EmbeddedResource Include="Scripts\Hw\Get-DxDiagInfo.ps1"    LogicalName="RTS.EmbeddedResources.Hw.Get-DxDiagInfo.ps1" />
    <EmbeddedResource Include="Scripts\Hw\Ensure-Tool.ps1"       LogicalName="RTS.EmbeddedResources.Hw.Ensure-Tool.ps1" />
  </ItemGroup>

</Project>
