<UserControl x:Class="RTS.Views.ModulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Osszes modul" Foreground="{DynamicResource SecondaryNeon}" FontSize="16" Margin="0,0,0,15"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ModulesPanel"/>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
