<UserControl x:Class="RTS.Views.IWSView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <StackPanel>
            <TextBlock Text="IWS - Telepites es Biztonsagi Protokollok" Foreground="{DynamicResource SecondaryNeon}" FontSize="16" Margin="0,0,0,20"/>

            <!-- A gombok az IWS repo (LordAthis/IWS) scripts\ mappajaban tenylegesen
                 letezo szkriptekre mutatnak, a CommandParameter tartalmazza a modulon
                 beluli relativ utvonalat, amit a ModuleRunner futtat. -->
            <WrapPanel x:Name="ButtonsPanel">
                <Button Content="Core Hardening (ASR+VBS)" Tag="XP,7,8,10,11"
                        CommandParameter="scripts\harden-windows-core.ps1"
                        Style="{StaticResource NeonButtonStyle}" Width="180" Height="50" Margin="5" Click="BtnExecute"/>

                <Button Content="Quad9 + DoH beallitas" Tag="7,8,10,11"
                        CommandParameter="scripts\set-quad9-doh.ps1"
                        Style="{StaticResource NeonButtonStyle}" Width="180" Height="50" Margin="5" Click="BtnExecute"/>

                <Button Content="USB tarolo blokkolas" Tag="XP,7,8,10,11"
                        CommandParameter="scripts\usb-restriction.ps1"
                        Style="{StaticResource NeonButtonStyle}" Width="180" Height="50" Margin="5" Click="BtnExecute"/>

                <Button Content="Bongeszo megerositese" Tag="7,8,10,11"
                        CommandParameter="scripts\browser-hardening.ps1"
                        Style="{StaticResource NeonButtonStyle}" Width="180" Height="50" Margin="5" Click="BtnExecute"/>

                <Button Content="Autoruns ellenorzes" Tag="XP,7,8,10,11"
                        CommandParameter="scripts\check-autoruns.ps1"
                        Style="{StaticResource NeonButtonStyle}" Width="180" Height="50" Margin="5" Click="BtnExecute"/>

                <Button Content="TELJES TELEPITES (mindent sorban)" Tag="XP,7,8,10,11"
                        CommandParameter="scripts\install-hardening.ps1"
                        Style="{StaticResource NeonButtonStyle}" Width="180" Height="50" Margin="5" Click="BtnExecute"/>
            </WrapPanel>

            <TextBlock Text="Minden script uj PowerShell ablakban indul - az RTS mar admin modban fut." Foreground="Gray" FontSize="11" FontStyle="Italic" Margin="5,15,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
