<UserControl x:Class="RTS.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Verzio: v2.1.0 - 2026-09-16

         ROUND17 VALTOZASOK:

         1. "Informaciok frissitese" = CSAK LEKERDEZES. A gomb mostantol a
            csendes, hatterben futo PowerShell-riportot inditja el
            (Scripts\Hw\Get-HardwareReport.ps1), es SEMMILYEN telepitest
            vagy letoltest NEM kezdemenyez. Ez volt LordAthis fo panasza:
            "Ez nem ujratelepites! Hanem elvileg annak a funkcionak a
            kivaltasa, ami minden hardvert lekerdez."

         2. SOTET TEMA / FEKETE SZOVEG - VALODI OK MEGTALALVA. A 4 lenyilo
            szekcio fejlecen a korabbi `Foreground="{DynamicResource
            TextBrush}"` NEM ERT CELT: a WPF beepitett Expander-sablonjaban
            a fejlec szoveget egy sajat ToggleButton rajzolja ki, amely a
            rendszer sajat (fekete) szoveg-szinet hasznalja, es NEM orokli
            a szulo Expander Foreground-jat. Ezert a fejlecek a sotet
            temaban is feketek maradtak. Javitas: a fejleceket mostantol
            EXPLICIT TextBlock-kent adjuk meg (Expander.Header), sajat,
            temafuggo Foreground-dal - igy garantaltan a temahoz igazodnak.

         3. Az eszkoz-lista sorai mostantol allapotfuggo gombokat kapnak
            (lasd ToolsView.xaml.cs): Telepites VAGY Megnyitas, plusz
            Frissites, ha van ujabb verzio, es "Uj gyorsjelentes", ami
            KIZAROLAG az adott komponenst kerdezi le ujra.

         ROUND18 VALTOZASOK:

         4. A lenyilo dobozok magassaga MOSTANTOL a TARTALOMHOZ igazodik.
            LordAthis 2026-09-16: "a dobozon belul is letrehoz egy
            gorgetheto dobozt, annak inkabb ne legyen fix merete, akkorara
            nyuljon, amekkora szukseges az adatok megjelenitesehez!"
            Ezert a rovid szekciokrol lekerult a MaxHeight es a fuggoleges
            gorgetosav - a doboz teljes magassagaban kiirja a tartalmat,
            es a panel SAJAT, kulso gorgetosavja gorget. KIVETEL a DXDIAG:
            az tobb ezer soros is lehet, ott marad egy (nagyobb) korlat,
            kulonben a panel hasznalhatatlanul hosszu lenne.

         5. Uj gomb a fejlecben: "Adatok kuldese uzenetben" - az osszegyujtott
            gepadatokat a DiagMailer-en keresztul kuldi el a beallitott
            cimre (lasd Services/DiagMailerLauncher.SendHardwareReport). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="15">
            <TextBlock Text="Eszkozok (hardver-lekerdezes)" Foreground="{DynamicResource SecondaryNeon}" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,10"/>

            <TextBlock x:Name="TxtLastQueried" TextWrapping="Wrap" Foreground="Gray" FontStyle="Italic" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <Button x:Name="BtnRefresh" Content="Informaciok frissitese" Style="{StaticResource NeonButtonStyle}"
                        HorizontalAlignment="Left" MinWidth="180" Height="35" Click="BtnRefresh_Click"/>
                <TextBlock x:Name="TxtRefreshHint" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="Gray" FontSize="11" FontStyle="Italic" TextWrapping="Wrap" MaxWidth="260"
                           Text="Csak lekerdezes - semmit nem telepit es nem tolt le."/>
                <Button x:Name="BtnSendReport" Content="Adatok kuldese uzenetben" Style="{StaticResource NeonButtonStyle}"
                        MinWidth="200" Height="35" Margin="12,0,0,0" Click="BtnSendReport_Click"/>
            </StackPanel>

            <!-- Gyors osszefoglalo - ugyanezt a tartalmat mutatja tomoritve a B2 doboz is. -->
            <Border Background="{DynamicResource SubPanelBgBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Gyors osszefoglalo" FontWeight="Bold" Foreground="{DynamicResource AccentNeon}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtSummary" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </Border>

            <!-- Reszletes, eszkozonkenti szekciok. A fejlecek EXPLICIT
                 TextBlock-ok (lasd a fenti 2. pontot) - a sima
                 Expander Foreground nem eleg a sotet temahoz. -->
            <Expander Margin="0,0,0,8">
                <Expander.Header>
                    <TextBlock Text="Processzor (CPU) reszletek" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                </Expander.Header>
                <TextBox x:Name="TxtCpuRaw" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11"
                         Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                         VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"/>
            </Expander>
            <Expander Margin="0,0,0,8">
                <Expander.Header>
                    <TextBlock Text="Videokartya (GPU) reszletek" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                </Expander.Header>
                <TextBox x:Name="TxtGpuRaw" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11"
                         Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                         VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"/>
            </Expander>
            <Expander Margin="0,0,0,8">
                <Expander.Header>
                    <TextBlock Text="Lemezek es SMART-allapot" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                </Expander.Header>
                <TextBox x:Name="TxtDiskRaw" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11"
                         Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                         VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"/>
            </Expander>
            <Expander Margin="0,0,0,8">
                <Expander.Header>
                    <TextBlock Text="Rendszer, alaplap, memoria" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                </Expander.Header>
                <TextBox x:Name="TxtSystemRaw" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11"
                         Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                         VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"/>
            </Expander>
            <Expander Margin="0,0,0,8">
                <Expander.Header>
                    <TextBlock Text="Homerseklet es szenzorok" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                </Expander.Header>
                <TextBox x:Name="TxtSensorsRaw" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11"
                         Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                         VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"/>
            </Expander>
            <Expander Margin="0,0,0,15">
                <Expander.Header>
                    <TextBlock Text="DXDIAG teljes riport (kulon keresre)" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                </Expander.Header>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button x:Name="BtnDxDiag" Content="DXDIAG lekerdezese" Style="{StaticResource NeonButtonStyle}"
                                MinWidth="150" Height="28" Click="BtnDxDiag_Click"/>
                        <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray" FontSize="11" FontStyle="Italic"
                                   TextWrapping="Wrap" MaxWidth="320"
                                   Text="Lassu (15-40 mp), ezert nem resze az automatikus lekerdezesnek."/>
                    </StackPanel>
                    <TextBox x:Name="TxtDxDiagRaw" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11"
                             Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                             MaxHeight="600" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"/>
                </StackPanel>
            </Expander>

            <!-- ───────── Lekerdezo eszkozok allapota es kezelese ───────── -->
            <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="Segedeszkozok allapota" FontWeight="Bold" Foreground="{DynamicResource AccentNeon}" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" FontStyle="Italic" Margin="0,0,0,10"
                               Text="A hardver-lekerdezes a Windows sajat adataibol (WMI) dolgozik, ezert ezek az eszkozok NEM kotelezoek - csak reszletesebb adatot adnak, ha telepitve vannak. Az RTS magatol SEMMIT nem telepit es SEMMILYEN oldalt nem nyit meg: minden muvelet a lenti gombokkal, a Te dontesedbol indul."/>
                    <ItemsControl x:Name="ToolStatusList"/>
                    <Button x:Name="BtnRecheckTools" Content="Allapot ujraellenorzese" Style="{StaticResource NeonButtonStyle}"
                            HorizontalAlignment="Left" MinWidth="170" Height="28" Margin="0,10,0,0" Click="BtnRecheckTools_Click"/>
                </StackPanel>
            </Border>

            <!-- ───────── RustDesk automatikus telepites BE/KI kapcsolo ───────── -->
            <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="ChkAutoInstall" Content="RustDesk automatikus telepitese es beallitasa"
                              Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextElement.FontSize="12"/>
                    <Button x:Name="BtnApplyAutoInstall" Content="Alkalmaz" Style="{StaticResource NeonButtonStyle}"
                            MinWidth="80" Height="30" Margin="15,0,0,0" Click="BtnApplyAutoInstall_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
