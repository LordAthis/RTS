<UserControl x:Class="RTS.Views.ModuleMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <DockPanel>
            <TextBlock x:Name="TxtTitle" DockPanel.Dock="Top" Text="Modul menu" Foreground="{DynamicResource SecondaryNeon}" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,15"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="CategoriesPanel"/>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
