<UserControl x:Class="RTS.Views.InfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <StackPanel>
            <TextBlock Text="RTS - Rendszerinfo es gyorsinditó" Foreground="{DynamicResource SecondaryNeon}" FontSize="16" Margin="0,0,0,20"/>

            <Border Background="{DynamicResource MainBgBrush}" BorderBrush="{DynamicResource AccentNeon}" BorderThickness="1" CornerRadius="10" Padding="15">
                <StackPanel x:Name="InfoPanel"/>
            </Border>

            <TextBlock Text="Gyors muveletek" Foreground="{DynamicResource SecondaryNeon}" FontSize="14" Margin="0,20,0,10"/>
            <WrapPanel>
                <Button x:Name="BtnOpenDataFolder" Content="Adatmappa megnyitasa" Style="{StaticResource NeonButtonStyle}" Width="180" Height="42" Margin="0,0,10,10" Click="BtnOpenDataFolder_Click"/>
                <Button x:Name="BtnCheckUpdates" Content="Frissitesek keresese" Style="{StaticResource NeonButtonStyle}" Width="180" Height="42" Margin="0,0,10,10" Click="BtnCheckUpdates_Click" ToolTip="Csak megnezi, van-e ujabb valtozat a GitHub-on - nem tolt le semmit"/>
                <Button x:Name="BtnReinstall" Content="Modulok ujratelepitese" Style="{StaticResource NeonButtonStyle}" Width="180" Height="42" Margin="0,0,10,10" Click="BtnReinstall_Click" ToolTip="Uj modulokat telepit ES a mar telepitett, elavult modulokat is frissiti"/>
                <Button x:Name="BtnRefresh" Content="Info frissitese" Style="{StaticResource NeonButtonStyle}" Width="180" Height="42" Margin="0,0,10,10" Click="BtnRefresh_Click"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
</UserControl>
